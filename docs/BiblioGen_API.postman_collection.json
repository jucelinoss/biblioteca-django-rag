	"item": [
		{
			"name": "Autenticação",
			"item": [
				{
					"name": "Obter Token (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access) {",
									"    pm.environment.set(\"jwt_access_token\", jsonData.access);",
									"    pm.collectionVariables.set(\"jwt_access_token\", jsonData.access);",
									"    console.log(\"Access Token JWT salvo com sucesso!\");",
									"}",
									"if (jsonData.refresh) {",
									"    pm.environment.set(\"jwt_refresh_token\", jsonData.refresh);",
									"    pm.collectionVariables.set(\"jwt_refresh_token\", jsonData.refresh);",
									"}",
									"pm.test(\"Login efetuado com sucesso (Status 200)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Retornou tokens JWT\", function () {",
									"    pm.expect(jsonData).to.have.property('access');",
									"    pm.expect(jsonData).to.have.property('refresh');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"bibliotecario\",\n    \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/token/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"token",
								""
							]
						},
						"description": "Gera os tokens JWT Access e Refresh utilizando as credenciais cadastradas."
					},
					"response": []
				},
				{
					"name": "Atualizar Token (Refresh)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access) {",
									"    pm.environment.set(\"jwt_access_token\", jsonData.access);",
									"    pm.collectionVariables.set(\"jwt_access_token\", jsonData.access);",
									"}",
									"pm.test(\"Token atualizado com sucesso\", function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(jsonData).to.have.property('access');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{jwt_refresh_token}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/token/refresh/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"token",
								"refresh",
								""
							]
						},
						"description": "Recebe o token de atualização (refresh) e retorna um novo token de acesso (access)."
					},
					"response": []
				}
			]
		},
